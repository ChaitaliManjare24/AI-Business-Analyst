# ---------------------------------------------------------------------------
# Copy this file to .env and fill in ONE provider key.
# Without a key the app runs on its built-in deterministic engine.
# Never commit .env — keys stay on the server and are never sent to the browser.
# ---------------------------------------------------------------------------

# Server
PORT=4173
NODE_ENV=development
# DATA_DIR=./data

# --- Pick one provider -----------------------------------------------------
# AI_PROVIDER=openai | anthropic | gemini | openrouter | local
AI_PROVIDER=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Request timeout for hosted models (ms)
AI_TIMEOUT_MS=45000
